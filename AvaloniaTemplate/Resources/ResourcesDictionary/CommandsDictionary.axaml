<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal"
                    xmlns:cmdUser="using:AvaloniaTemplate.Infrastructures.Commands.UserCommand"
                    >
    
    <!-- Add Resources Here -->
    <cmdUser:Command_Paste x:Key= "Command_Paste"/>
    <cmdUser:Command_Cut x:Key= "Command_Cut"/>
    <cmdUser:Command_Copy x:Key= "Command_Copy"/>
    <cmdUser:Command_SimpleAs x:Key= "Command_SimpleAs"/>
    <cmdUser:Command_PreViewSelectedFont x:Key= "Command_PreViewSelectedFont"/>
    <cmdUser:Command_PreViewSelectedFontSize x:Key= "Command_PreViewSelectedFontSize"/>
    <cmdUser:Command_SetFontWeightBold x:Key= "Command_SetFontWeightBold"/>
    <cmdUser:Command_SetFontStyleItalic x:Key= "Command_SetFontStyleItalic"/>
    <cmdUser:Command_SetTextStyleUnderline x:Key= "Command_SetTextStyleUnderline"/>
    
</ResourceDictionary>
