<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"
        xmlns:helper="using:AvaloniaTemplate.Infrastructures.Helpers"
        >
    
    <Design.PreviewWith>
        <Border Padding="20">
            <controls:ComboBoxWithFonts  Width="250"/>
        </Border>
    </Design.PreviewWith>
    
    <ControlTheme x:Key="{x:Type controls:ComboBoxWithFonts}"
                  TargetType="controls:ComboBoxWithFonts"
                  >
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <ControlTemplate>
                <ComboBox x:Name="PART_RootPanel"
                          SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                          ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                          Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          MinWidth="{TemplateBinding MinWidth}"
                          MinHeight="{TemplateBinding MinHeight}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          >
                    <!--<ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="FontFamily">
                            <Border Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    >
                                <TextBlock Text="{Binding Name}" FontFamily="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>-->

                    <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate x:DataType="FontFamily">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
