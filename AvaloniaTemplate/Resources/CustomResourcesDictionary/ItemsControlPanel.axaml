<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"
        >

    <Design.PreviewWith>
        <Border Padding="20">
             <controls:ItemsControlPanel/>
        </Border>
    </Design.PreviewWith>
    
    
    
    <ControlTheme x:Key="{x:Type controls:ItemsControlPanel}"
                  TargetType="controls:ItemsControlPanel"
                  >
    <Setter Property="Template">
      <ControlTemplate>
        <TextBlock Text="Templated Control" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
