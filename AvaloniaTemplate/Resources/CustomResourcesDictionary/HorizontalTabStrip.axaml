<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"
        >

    <Design.PreviewWith>
        <Border Padding="20">
             <controls:HorizontalTabStrip Width="150" Height="30"/>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:HorizontalTabStrip}"
                  TargetType="controls:HorizontalTabStrip"
                  >


        <Setter Property="Template">
            <ControlTemplate>
               <Grid ColumnDefinitions="auto auto auto * auto"
                     Background="{TemplateBinding Background}"
                     >
                   <RepeatButton x:Name="PART_ButtonNextLeft"
                                 Grid.Column="0"
                                 Padding="0"
                                 Background="Transparent"
                                 MinWidth="25"
                                 MinHeight="25"
                                 >
                       <PathIcon Data="M12,0 L4,8 L12,16 Z"
                                 Foreground="Gray"
                                 Height="12"
                                 />
                   
                   </RepeatButton>

                   <RepeatButton x:Name="PART_ButtonNextRight"
                                 Grid.Column="1"
                                 Padding="0"
                                 Background="Transparent"
                                 MinWidth="25"
                                 MinHeight="25"
                                 >
                       <PathIcon Data="M4,0 L12,8 L4,16 Z"
                                 Foreground="Gray"
                                 Height="12"
                                 />
                   
                   </RepeatButton>

                   <ToggleButton x:Name="ViewItemList"
                                 Grid.Column="2"
                                 Padding="0"
                                 Classes="highlightedBackground"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Content="..."
                                 MinWidth="35"
                                 MinHeight="25"
                                 IsChecked="{Binding IsPopupOpenned, RelativeSource={RelativeSource TemplatedParent}}"
                                 />

                   <ScrollViewer x:Name="PART_Scroll"
                                 Grid.Column="3"
                                 HorizontalScrollBarVisibility="Hidden"
                                 VerticalScrollBarVisibility="Disabled"
                                 >
                       
                       <ListBox Margin="10 0 0 0"
                                ItemsSource="{TemplateBinding SourceItems}"
                                SelectedItem="{TemplateBinding SelectedItem}"
                                ItemTemplate="{TemplateBinding ItemTemplate}"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                />
                   </ScrollViewer>

                   <Button Grid.Column="4"
                           Padding="5 2 5 2"
                           Classes="highlightedBackground"
                           BorderThickness="0"
                           Background="Transparent"
                           MinWidth="25"
                           MinHeight="25"
                           HorizontalAlignment="Right"
                           Command="{TemplateBinding Command}"
                           CommandParameter="{TemplateBinding CommandParameter}"
                           >
                       
                       <PathIcon UseLayoutRounding="False"
                                 IsHitTestVisible="False"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Width="12"
                                 Height="12"
                                 Foreground="{DynamicResource ComboBoxDropDownGlyphForeground}"
                                 Data="M7,1 L9,1 L9,7 L15,7 L15,9 L9,9 L9,15 L7,15 L7,9 L1,9 L1,7 L7,7 Z"
                                 />
                   </Button>

                   <Popup Name="PART_Popup"
                           WindowManagerAddShadowHint="False"
                           IsOpen="{TemplateBinding IsPopupOpenned, Mode=TwoWay}"
                           IsLightDismissEnabled="True"
                           InheritsTransform="True"
                           MinHeight="15"
                           MinWidth="100"
                           PlacementTarget="ViewItemList"
                           Placement="TopEdgeAlignedLeft"
                           >

                        <!--TopEdgeAlignedLeft-->
                        <Border x:Name="PopupBorder"
                                Background="LightGray"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                Padding="0"
                                Margin="0 0 1 0"
                                HorizontalAlignment="Stretch"
                                CornerRadius="5"
                                Child="{Binding PopupContent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                />
                    </Popup>
               
               </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
