<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"
        >

    <Design.PreviewWith>
        <Border Padding="20">
            <controls:ButtonSetGridStyle />
        </Border>
    </Design.PreviewWith>
    
    
    <ControlTheme x:Key="{x:Type controls:ButtonSetGridStyle}"
                  TargetType="controls:ButtonSetGridStyle"
                  >
        <Setter Property="Template">
            <ControlTemplate>
                <Button Padding="0"
                        Background="Transparent"
                        CornerRadius="0"
                        Classes="disableBackgroundTransparent">
                    
                    <Button.Content>
                            
                        <Grid ColumnDefinitions="* auto">
                            <TextBlock Text="+"/>

                            <ToggleButton Grid.Column="1"
                                            Padding="0 0 0 0"
                                            CornerRadius="0"
                                            Background="Transparent"
                                            >
                        

                                <ToggleButton.Content>
                                    <PathIcon Padding="0 0"
                                                Width="9"
                                                Height="9"
                                                Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z"
                                                />
                                </ToggleButton.Content>
                            </ToggleButton>
                        </Grid>

                    </Button.Content>
                    
                    
                </Button>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
