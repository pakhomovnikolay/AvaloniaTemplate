<Window xmlns="https://github.com/avaloniaui"
        xmlns:base="using:AvaloniaTemplate.Resources.CustomResourcesDictionary.Base"
        xmlns:controls="using:AvaloniaTemplate.Resources.CustomResourcesDictionary.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:AvaloniaTemplate.ViewModels"
		xmlns:crd="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"
		xmlns:helpers="using:AvaloniaTemplate.Infrastructures.Helpers"

        x:Class="AvaloniaTemplate.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

		Icon="/Assets/AppImage.ico"
		CanResize="True"
		WindowStartupLocation="CenterScreen"
		Background="WhiteSmoke"
		Title="{Binding Title}"
		Height="{Binding WindowHeight}"
		Width="{Binding WindowWidth}"
		Padding="5"
		>

	<StackPanel Orientation="Horizontal"
				Spacing="5"
				>
		<Grid ColumnDefinitions="auto auto"
			  RowDefinitions="auto auto auto"
			  >
			<controls:ButtonClipboard Grid.Column="0"
									  Grid.Row="0"
									  Grid.RowSpan="3"
									  ClipboardType="Paste"
									  ImageWidth="45"
									  ImageHeight="55"
									  Spacing="-5"
									  Command="{Binding ConnectorService.Command_Paste}"
									  />

			<controls:ButtonClipboard Grid.Column="1"
									  Grid.Row="0"
									  ClipboardType="Cut"
									  Command="{Binding ConnectorService.Command_Cut}"
									  />

			<controls:ButtonClipboard Grid.Column="1"
									  Grid.Row="1"
									  ClipboardType="Copy"
									  Command="{Binding ConnectorService.Command_Copy}"
									  />

			<controls:ButtonClipboard Grid.Column="1"
									  Grid.Row="2"
									  ClipboardType="AsSimple"
									  Command="{Binding ConnectorService.Command_AsSimple}"
									  />
		</Grid>
		
		<Grid RowDefinitions="25 auto"
			  RowSpacing="3"
			  >
			<Grid Grid.Row="0"
				  ColumnDefinitions="160 auto"
				  ColumnSpacing="1"
				  >
				<controls:FontSelectorToolkit Grid.Column="0"
											  ToolkitType="FontList"
											  helpers:FontFamilyHelper.ControlPreviewFont="True"
											  helpers:FontFamilyHelper.ControlFontChanged="True"
											  />

				<controls:FontSelectorToolkit Grid.Column="1"
											  ToolkitType="FontSizeList"
											  helpers:FontFamilyHelper.ControlPreviewFontSize="True"
											  helpers:FontFamilyHelper.ControlFontSizeCHanged="True"
											  />
			</Grid>

			<Grid Grid.Row="1"
				  ColumnDefinitions="30 30 30"
				  ColumnSpacing="2"
				  >
				<controls:FontStyleToolkit Grid.Column="0"
										   ToolkitType="FontWeightBold"
										   Height="25"
										   FontSize="11"
										   IsChecked="{Binding ConnectorService.IsFontWeightBold}"
										   Command="{Binding ConnectorService.Command_ChangeFontWeightBold}"
										   />
                <controls:FontStyleToolkit Grid.Column="1"
										   ToolkitType="FontStyleItalic"
										   Height="25"
										   FontSize="12"
										   IsChecked="{Binding ConnectorService.IsFontStyleItalic}"
										   Command="{Binding ConnectorService.Command_ChangeFontStyleItalic}"
										   />
                <controls:FontStyleToolkit Grid.Column="2"
										   ToolkitType="TextStyleUnderLine"
										   Height="25"
										   FontSize="12"
										   IsChecked="{Binding ConnectorService.IsTextUnderline}"
										   Command="{Binding ConnectorService.Command_ChangeTextUnderline}"
										   />
			</Grid>
		</Grid>
	</StackPanel>
</Window>
