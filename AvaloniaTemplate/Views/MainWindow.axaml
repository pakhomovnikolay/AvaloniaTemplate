<Window xmlns="https://github.com/avaloniaui"
        xmlns:customresourcesdictionary="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:AvaloniaTemplate.ViewModels"

        x:Class="AvaloniaTemplate.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

		Icon="/Assets/AppImage.ico"
		CanResize="True"
		WindowStartupLocation="CenterScreen"
		Background="WhiteSmoke"
		Title="{Binding Title}"
		Height="{Binding WindowHeight}"
		Width="{Binding WindowWidth}"
		>

	<customresourcesdictionary:ButtonPaste HorizontalAlignment="Left"
										   VerticalAlignment="Top"
										   Margin="5"
										   Command="{StaticResource Command_Paste}"
										   CommandParameter="True"
										   >
		
	</customresourcesdictionary:ButtonPaste>

</Window>
