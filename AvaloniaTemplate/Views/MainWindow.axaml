<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:AvaloniaTemplate.ViewModels"
		xmlns:customresourcesdictionary="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"

        x:Class="AvaloniaTemplate.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

		Icon="/Assets/AppImage.ico"
		CanResize="True"
		WindowStartupLocation="CenterScreen"
		Background="WhiteSmoke"
		Title="{Binding Title}"
		Height="{Binding WindowHeight}"
		Width="{Binding WindowWidth}"
		>

	<StackPanel Margin="5" Spacing="5">

		<Grid ColumnDefinitions="auto auto auto">
			<customresourcesdictionary:ButtonPaste Command="{StaticResource Command_Paste}"
												   CommandParameter="{Binding GlobalStateService.ClipboardIsNotEmpty}"
												   />

			<Grid Grid.Column="1" RowDefinitions="auto auto auto">
				<customresourcesdictionary:ButtonCut Command="{StaticResource Command_Cut}"
													 />

				<customresourcesdictionary:ButtonCopy Grid.Row="1"
													  Command="{StaticResource Command_Copy}"
													  />

				<customresourcesdictionary:ButtonSimpleAs Grid.Row="2"
														  Command="{StaticResource Command_SimpleAs}"
														  />
			</Grid>

			<Grid Grid.Column="2" RowDefinitions="auto auto auto">
				<customresourcesdictionary:ButtonWrapText Command="{StaticResource Command_WrapText}"
														  IsChecked="{Binding GlobalStateService.IsWrapText}"
														  />

				<customresourcesdictionary:ButtonMergeCells Grid.Row="1"
														  Command="{StaticResource Command_MergeCells}"
														  IsChecked="{Binding GlobalStateService.IsMergeCell}"
														  />
			</Grid>
		</Grid>

		<Grid ColumnDefinitions="auto 125 30 30 30">
			<customresourcesdictionary:ComboBoxWithFonts SelectedItem="{Binding GlobalStateService.CurrentFontFamily}"
														 Command="{StaticResource Command_SelectedFont}"
														 CommandPreview="{StaticResource Command_PreViewSelectedFont}"
														 Width="150"
														 />

			<customresourcesdictionary:ComboBoxWithFontsSize Grid.Column="1"
															 SelectedItem="{Binding GlobalStateService.CurrentFontSize}"
															 Command="{StaticResource Command_SelectedFontSize}"
															 CommandPreview="{StaticResource Command_PreViewSelectedFontSize}"
															 Margin="0 0 0 0"
															 />

			<customresourcesdictionary:ButtonSetTextPosition Grid.Column="2"
															 Position="Vertical"
															 VerticalPosition="Top"
															 Command="{StaticResource Command_SetTextVerticalAlignment}"
															 />

			<customresourcesdictionary:ButtonSetTextPosition Grid.Column="3"
															 Position="Vertical"
															 VerticalPosition="Center"
															 Command="{StaticResource Command_SetTextVerticalAlignment}"
															 />

			<customresourcesdictionary:ButtonSetTextPosition Grid.Column="4"
															 Position="Vertical"
															 VerticalPosition="Bottom"
															 Command="{StaticResource Command_SetTextVerticalAlignment}"
															 />


			

		</Grid>

		<Grid ColumnDefinitions="35 35 35 42 45 45 35 auto auto auto">
			<customresourcesdictionary:ButtonSetFontWeightBold Command="{StaticResource Command_SetFontWeightBold}"
															   IsChecked="{Binding GlobalStateService.IsFontWeightBold}"
															   />

			<customresourcesdictionary:ButtonSetFontStyleItalic Grid.Column="1"
																Command="{StaticResource Command_SetFontStyleItalic}"
																IsChecked="{Binding GlobalStateService.IsFontStyleItalic}"
																/>

			<customresourcesdictionary:ButtonSetTextStyleUnderLine Grid.Column="2"
																   Command="{StaticResource Command_SetTextStyleUnderline}"
																   IsChecked="{Binding GlobalStateService.IsTextStyleUnderline}"
																   />

			<customresourcesdictionary:ButtonSetGridStyle Grid.Column="3"
														  Content="{Binding GlobalStateService.CurrentBorderStyle}"
														  Command="{StaticResource Command_ChangeStyleGrid}"
														  CommandParameter="{Binding GlobalStateService.BorderStyleType}"
														  />
			

			<customresourcesdictionary:ButtonSetBackgroundStyle Grid.Column="4"
																Command="{StaticResource Command_SetBackgroundStyle}"
																CommandParameter="{Binding GlobalStateService.CurrentBackground}"
																CurrentBackgroundColor="{Binding GlobalStateService.CurrentBackground}"
																/>

			<customresourcesdictionary:ButtonSetForegroundStyle Grid.Column="5"
																Command="{StaticResource Command_SetForegroundStyle}"
																CommandParameter="{Binding GlobalStateService.CurrentForeground}"
																CurrentForegroundColor="{Binding GlobalStateService.CurrentForeground}"
																/>

			<customresourcesdictionary:ButtonSetTextPosition Grid.Column="7"
															 Width="30"
															 Position="Horizontal"
															 HorizontalPosition="Left"
															 Command="{StaticResource Command_SetTextHorizontalAlignment}"
															 />

			<customresourcesdictionary:ButtonSetTextPosition Grid.Column="8"
															 Width="30"
															 Position="Horizontal"
															 HorizontalPosition="Center"
															 Command="{StaticResource Command_SetTextHorizontalAlignment}"
															 />

			<customresourcesdictionary:ButtonSetTextPosition Grid.Column="9"
															 Width="30"
															 Position="Horizontal"
															 HorizontalPosition="Right"
															 Command="{StaticResource Command_SetTextHorizontalAlignment}"
															 />
		</Grid>



		<Grid ColumnDefinitions="300">
			<StackPanel Orientation="Horizontal" Spacing="10">
				<customresourcesdictionary:ButtonSetFontWeightBold IsChecked="{Binding GlobalStateService.IsFontWeightBold}"
																   />
				<customresourcesdictionary:ButtonSetFontStyleItalic IsChecked="{Binding GlobalStateService.IsFontStyleItalic}"
																	/>
				<customresourcesdictionary:ButtonSetTextStyleUnderLine IsChecked="{Binding GlobalStateService.IsTextStyleUnderline}"
																	   />
				<customresourcesdictionary:ButtonSetTextPosition Position="Vertical"
																 VerticalPosition="Top"
																 >
					<customresourcesdictionary:ButtonSetTextPosition.IsChecked>
						<MultiBinding Converter="{StaticResource Converter_CurrentTextAlignmentToBool}">
							<Binding Path="Position" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="VerticalPosition" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="GlobalStateService.VerticalTextAlignment" />
						</MultiBinding>
					</customresourcesdictionary:ButtonSetTextPosition.IsChecked>
				</customresourcesdictionary:ButtonSetTextPosition>

				<customresourcesdictionary:ButtonSetTextPosition Position="Vertical"
																 VerticalPosition="Center"
																 >
					<customresourcesdictionary:ButtonSetTextPosition.IsChecked>
						<MultiBinding Converter="{StaticResource Converter_CurrentTextAlignmentToBool}">
							<Binding Path="Position" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="VerticalPosition" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="GlobalStateService.VerticalTextAlignment" />
						</MultiBinding>
					</customresourcesdictionary:ButtonSetTextPosition.IsChecked>
				</customresourcesdictionary:ButtonSetTextPosition>

				<customresourcesdictionary:ButtonSetTextPosition Position="Vertical"
																 VerticalPosition="Bottom"
																 >
					<customresourcesdictionary:ButtonSetTextPosition.IsChecked>
						<MultiBinding Converter="{StaticResource Converter_CurrentTextAlignmentToBool}">
							<Binding Path="Position" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="VerticalPosition" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="GlobalStateService.VerticalTextAlignment" />
						</MultiBinding>
					</customresourcesdictionary:ButtonSetTextPosition.IsChecked>
				</customresourcesdictionary:ButtonSetTextPosition>

				<customresourcesdictionary:ButtonSetTextPosition Width="30"
																 Position="Horizontal"
																 HorizontalPosition="Left"
																 >
					<customresourcesdictionary:ButtonSetTextPosition.IsChecked>
						<MultiBinding Converter="{StaticResource Converter_CurrentTextAlignmentToBool}">
							<Binding Path="Position" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="HorizontalPosition" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="GlobalStateService.HorizontalTextAlignment" />
						</MultiBinding>
					</customresourcesdictionary:ButtonSetTextPosition.IsChecked>
				</customresourcesdictionary:ButtonSetTextPosition>

				<customresourcesdictionary:ButtonSetTextPosition Width="30"
																 Position="Horizontal"
																 HorizontalPosition="Center"
																 >
					<customresourcesdictionary:ButtonSetTextPosition.IsChecked>
						<MultiBinding Converter="{StaticResource Converter_CurrentTextAlignmentToBool}">
							<Binding Path="Position" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="HorizontalPosition" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="GlobalStateService.HorizontalTextAlignment" />
						</MultiBinding>
					</customresourcesdictionary:ButtonSetTextPosition.IsChecked>
				</customresourcesdictionary:ButtonSetTextPosition>

				<customresourcesdictionary:ButtonSetTextPosition Width="30"
																 Position="Horizontal"
																 HorizontalPosition="Right"
																 >
					<customresourcesdictionary:ButtonSetTextPosition.IsChecked>
						<MultiBinding Converter="{StaticResource Converter_CurrentTextAlignmentToBool}">
							<Binding Path="Position" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="HorizontalPosition" RelativeSource="{RelativeSource Self}"/>
							<Binding Path="GlobalStateService.HorizontalTextAlignment" />
						</MultiBinding>
					</customresourcesdictionary:ButtonSetTextPosition.IsChecked>
				</customresourcesdictionary:ButtonSetTextPosition>

				<customresourcesdictionary:ButtonWrapText IsChecked="{Binding GlobalStateService.IsWrapText}"
														  />

				<customresourcesdictionary:ButtonMergeCells IsChecked="{Binding GlobalStateService.IsMergeCell}"
															/>

				<TextBox Width="150"/>
			</StackPanel>

		</Grid>
	</StackPanel>
</Window>
