<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:AvaloniaTemplate.ViewModels"
		xmlns:customResources="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"

        x:Class="AvaloniaTemplate.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

		Icon="/Assets/AppImage.ico"
		CanResize="True"
		WindowStartupLocation="CenterScreen"
		Background="WhiteSmoke"
		Title="{Binding Title}"
		Height="{Binding WindowHeight}"
		Width="{Binding WindowWidth}"
		>

	<Grid RowDefinitions="25 5 30 5 25 5 30 5 25 *" Margin="5">
		
		<Grid Grid.Row="0" ColumnDefinitions="* 50">
			<customResources:BorderWithTextBox Grid.Column="0"
											   Header="Путь к файлу шифрования:"
											   Text="{Binding FilePath}"
											   BorderThickness="1 1 0 1"
											   Padding="5 0 10 0"
											   />

			<Button Grid.Column="1"
					Content="..."
					Background="White"
					BorderThickness="1"
					BorderBrush="Black"
					Margin="-10 0 0 0"
					IsEnabled="True"
					Command="{Binding Command_SelectedFileSource}"
					/>

		</Grid>

		<Grid Grid.Row="2" ColumnDefinitions="120 5 120 *">
			<Button Grid.Column="0"
					Content="Зашифровать"
					BorderThickness="1"
					BorderBrush="Black"
					IsEnabled="True"
					Command="{Binding Command_Encryption}"
					CommandParameter="{Binding FilePath}"
					/>


		</Grid>

		<Grid Grid.Row="4" ColumnDefinitions="* 50">
			<customResources:BorderWithTextBox Grid.Column="0"
											   Header="Путь к файлу дешифрования:"
											   Text="{Binding TargetFilePath}"
											   BorderThickness="1 1 0 1"
											   Padding="5 0 10 0"
											   />

			<Button Grid.Column="1"
					Content="..."
					Background="White"
					BorderThickness="1"
					BorderBrush="Black"
					Margin="-10 0 0 0"
					IsEnabled="True"
					Command="{Binding Command_SelectedFileTarget}"
					/>

		</Grid>

		<Grid Grid.Row="6" ColumnDefinitions="120 5 120 *">

			<Button Grid.Column="0"
					Content="Расшифровать"
					BorderThickness="1"
					BorderBrush="Black"
					IsEnabled="True"
					Command="{Binding Command_Decryption}"
					CommandParameter="{Binding FilePath}"
					/>

			

		</Grid>

		<ProgressBar Grid.Row="8"
					 Minimum="0"
					 Maximum="1"
					 VerticalAlignment="Stretch"
					 Value="{Binding Proccess}"
					 Foreground="Green"
					 Background="LightGreen"
					 BorderThickness="1"
					 BorderBrush="Gray"
					 />
	
	</Grid>

</Window>
