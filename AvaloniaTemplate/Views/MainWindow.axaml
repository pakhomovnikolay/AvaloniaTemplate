<Window xmlns="https://github.com/avaloniaui"
        xmlns:customresourcesdictionary="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:AvaloniaTemplate.ViewModels"

        x:Class="AvaloniaTemplate.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

		Icon="/Assets/AppImage.ico"
		CanResize="True"
		WindowStartupLocation="CenterScreen"
		Background="WhiteSmoke"
		Title="{Binding Title}"
		Height="{Binding WindowHeight}"
		Width="{Binding WindowWidth}"
		>

	<StackPanel Margin="5" Spacing="5">

		<Grid ColumnDefinitions="auto auto">
			<customresourcesdictionary:ButtonPaste Command="{StaticResource Command_Paste}"
												   CommandParameter="{Binding GlobalStateService.ClipboardIsNotEmpty}"
												   />

			<Grid Grid.Column="1" RowDefinitions="auto auto auto">
				<customresourcesdictionary:ButtonCut Command="{StaticResource Command_Cut}"
													 />

				<customresourcesdictionary:ButtonCopy Grid.Row="1"
													  Command="{StaticResource Command_Copy}"
													  />

				<customresourcesdictionary:ButtonSimpleAs Grid.Row="2"
														  Command="{StaticResource Command_SimpleAs}"
														  />
			</Grid>
		</Grid>

		<Grid ColumnDefinitions="auto auto">
			<customresourcesdictionary:ComboBoxWithFonts Width="150"
														 SelectedItem="{Binding GlobalStateService.CurrentFontFamily}"
														 Command="{StaticResource Command_SelectedFont}"
														 CommandPreview="{StaticResource Command_PreViewSelectedFont}"
														 />

			<customresourcesdictionary:ComboBoxWithFontsSize Grid.Column="1"
															 Width="120"
															 SelectedItem="{Binding GlobalStateService.CurrentFontSize}"
															 Command="{StaticResource Command_SelectedFontSize}"
															 CommandPreview="{StaticResource Command_PreViewSelectedFontSize}"
															 />
		</Grid>

		<Grid ColumnDefinitions="35 35 35 50 50 50">
			<customresourcesdictionary:ButtonSetFontWeightBold Command="{StaticResource Command_SetFontWeightBold}"
															   IsChecked="{Binding GlobalStateService.IsFontWeightBold}"
															   />

			<customresourcesdictionary:ButtonSetFontStyleItalic Grid.Column="1"
																Command="{StaticResource Command_SetFontStyleItalic}"
																IsChecked="{Binding GlobalStateService.IsFontStyleItalic}"
																/>

			<customresourcesdictionary:ButtonSetTextStyleUnderLine Grid.Column="2"
																   Command="{StaticResource Command_SetTextStyleUnderline}"
																   IsChecked="{Binding GlobalStateService.IsTextStyleUnderline}"
																   />

			<customresourcesdictionary:ButtonSetGridStyle Grid.Column="3"
														  Content="{Binding GlobalStateService.CurrentBorderStyle}"
														  Command="{StaticResource Command_ChangeStyleGrid}"
														  CommandParameter="{Binding GlobalStateService.BorderStyleType}"
														  />
			

			<customresourcesdictionary:ButtonSetBackgroundStyle Grid.Column="4"
																Command="{StaticResource Command_SetBackgroundStyle}"
																CommandParameter="{Binding GlobalStateService.CurrentBackground}"
																CurrentBackgroundColor="{Binding GlobalStateService.CurrentBackground}"
																/>

			<customresourcesdictionary:ButtonSetForegroundStyle Grid.Column="5"
																Command="{StaticResource Command_SetForegroundStyle}"
																CommandParameter="{Binding GlobalStateService.CurrentForeground}"
																CurrentForegroundColor="{Binding GlobalStateService.CurrentForeground}"
																/>
		</Grid>
	</StackPanel>
</Window>
