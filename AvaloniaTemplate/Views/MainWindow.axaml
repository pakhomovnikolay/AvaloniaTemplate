<Window xmlns="https://github.com/avaloniaui"
        xmlns:customresourcesdictionary="using:AvaloniaTemplate.Resources.CustomResourcesDictionary"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:AvaloniaTemplate.ViewModels"

        x:Class="AvaloniaTemplate.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

		Icon="/Assets/AppImage.ico"
		CanResize="True"
		WindowStartupLocation="CenterScreen"
		Background="WhiteSmoke"
		Title="{Binding Title}"
		Height="{Binding WindowHeight}"
		Width="{Binding WindowWidth}"
		>

	<StackPanel Margin="5" Spacing="5">

		<Grid ColumnDefinitions="auto auto">
			<customresourcesdictionary:ButtonPaste/>

			<Grid Grid.Column="1" RowDefinitions="auto auto auto">
				<customresourcesdictionary:ButtonCut/>

				<customresourcesdictionary:ButtonCopy Grid.Row="1"/>

				<customresourcesdictionary:ButtonSimpleAs Grid.Row="2"/>
			</Grid>
		</Grid>

		<Grid ColumnDefinitions="auto auto">
			<customresourcesdictionary:ComboBoxWithFonts Width="150"/>

			<customresourcesdictionary:ComboBoxWithFontsSize Grid.Column="1" Width="115"/>
		</Grid>

		<Grid ColumnDefinitions="35 35 35 50 50">
			<customresourcesdictionary:ButtonSetFontWeightBold />

			<customresourcesdictionary:ButtonSetFontStyleItalic Grid.Column="1"/>

			<customresourcesdictionary:ButtonSetTextStyleUnderLine Grid.Column="2"/>

			<customresourcesdictionary:ButtonSetGridStyle Grid.Column="3"/>

			<customresourcesdictionary:ButtonSetBackgroundStyle Grid.Column="4"/>
			
		</Grid>
	</StackPanel>
</Window>
